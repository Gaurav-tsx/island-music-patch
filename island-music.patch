diff --git a/windows/src/island/youtube-music.ts b/windows/src/island/youtube-music.ts
new file mode 100644
index 0000000..9db3f96
--- /dev/null
+++ b/windows/src/island/youtube-music.ts
@@ -0,0 +1,35 @@
+import { Bridge, IS_TAURI } from "../core/bridge";
+import { State } from "../core/state";
+import { YouTubeMusic, YOUTUBE_MUSIC_ID } from "../core/youtube-music";
+import type { SpotifyHost } from "./spotify";
+
+export function registerYouTubeMusic(island: SpotifyHost) {
+  if (!IS_TAURI || State.os !== "windows") return;
+
+  const declared = () => State.settings.activeIntegrations.includes(YOUTUBE_MUSIC_ID);
+  State.subscribe(() => {
+    const task = State.tasks.find((task) => task.id === YOUTUBE_MUSIC_ID);
+    if (task) task.name = YouTubeMusic.playback?.title || "YouTube Music";
+    else YouTubeMusic.playback = null;
+  });
+
+  async function refresh() {
+    if (declared()) {
+      const next = await Bridge.youtubeMusicState();
+      if (declared()) {
+        const wasPlaying = State.youtubeMusicPlaying;
+        const previous = YouTubeMusic.playback;
+        if (next?.title !== previous?.title || next?.artist !== previous?.artist
+          || next?.playing !== previous?.playing || next?.volume !== previous?.volume) {
+          YouTubeMusic.playback = next;
+          if (!wasPlaying && State.youtubeMusicPlaying && !State.paused && State.mode === "hidden") {
+            island.revealSilently();
+          }
+          State.notify();
+        }
+      }
+    }
+    window.setTimeout(() => void refresh(), 800);
+  }
+  void refresh();
+}
