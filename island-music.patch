diff --git a/windows/src/views/youtube-music.ts b/windows/src/views/youtube-music.ts
new file mode 100644
index 0000000..2c448f0
--- /dev/null
+++ b/windows/src/views/youtube-music.ts
@@ -0,0 +1,158 @@
+import { Bridge } from "../core/bridge";
+import { State, type AgentTask } from "../core/state";
+import { YouTubeMusic, type YouTubeMusicResult } from "../core/youtube-music";
+import { t, tl } from "../i18n/i18n";
+import { clear, dot, h, svg } from "./dom";
+import { ICONS } from "./icons";
+import { buildSpotifyPill } from "./spotify";
+
+export function buildYouTubeMusicPill(task: AgentTask, onTap: () => void) {
+  return buildSpotifyPill(task, onTap, {
+    dancing: () => State.youtubeMusicPlaying,
+    playback: () => ({
+      track: YouTubeMusic.playback?.title || null,
+      playing: State.youtubeMusicPlaying,
+    }),
+    toggle: () => void Bridge.youtubeMusicControl("toggle"),
+    next: () => void Bridge.youtubeMusicControl("next"),
+  });
+}
+
+export function buildYouTubeMusicCard(keyboard: (on: boolean) => void) {
+  const title = h("span", { class: "np-title" });
+  const artist = h("div", { class: "np-sub" });
+  const open = h("button", {
+    type: "button", class: "np-art", title: tl("Open YouTube Music"), "aria-label": tl("Open YouTube Music"),
+  }, svg(ICONS.musicNote, 16));
+  const head = h("div", { class: "np-head" }, open,
+    h("div", { class: "np-text" }, h("div", { class: "np-title-row" }, dot("#FF4545", 6), title), artist),
+  );
+  const query = h("input", {
+    type: "search", maxlength: 200, placeholder: tl("Search songs and playlists"),
+    "aria-label": tl("Search songs and playlists"),
+  });
+  const error = h("div", { class: "np-sub", role: "status" });
+  const search = h("button", { type: "submit", class: "link-btn", text: tl("Search") });
+  const form = h("form", { class: "np-youtube-search" }, query, search);
+  const songs = h("button", { type: "button", class: "link-btn", text: tl("Songs") });
+  const playlists = h("button", { type: "button", class: "link-btn", text: tl("Playlists") });
+  const close = h("button", { type: "button", class: "icon-btn", "aria-label": tl("Close") }, svg(ICONS.xmark, 12));
+  const matches = h("div", { class: "np-result-list", "aria-live": "polite" });
+  const resultsEl = h("div", { class: "np-results" }, h("div", { class: "np-result-tabs" }, songs, playlists, close), matches);
+  resultsEl.style.display = "none";
+  let results: YouTubeMusicResult[] = [];
+  let selectedKind: YouTubeMusicResult["kind"] = "song";
+  let showResults = false;
+
+  function renderResults() {
+    songs.setAttribute("aria-pressed", String(selectedKind === "song"));
+    playlists.setAttribute("aria-pressed", String(selectedKind === "playlist"));
+    clear(matches);
+    const visible = results.filter((result) => result.kind === selectedKind);
+    if (!visible.length) matches.append(h("div", { class: "np-sub", text: tl("Nothing found") }));
+    for (const result of visible) {
+      const button = h("button", { type: "button", class: "np-result", title: result.title },
+        svg(ICONS.play, 11), h("span", { text: result.title }));
+      button.addEventListener("click", async () => {
+        button.disabled = true;
+        error.textContent = "";
+        if (await Bridge.youtubeMusicPlay(result)) {
+          showResults = false;
+          State.notify();
+        } else {
+          error.textContent = t("Failed");
+        }
+        button.disabled = false;
+      });
+      matches.append(button);
+    }
+  }
+
+  for (const [kind, button] of [["song", songs], ["playlist", playlists]] as const) {
+    button.addEventListener("click", () => {
+      if (search.disabled) return;
+      selectedKind = kind;
+      renderResults();
+    });
+  }
+  close.addEventListener("click", () => {
+    showResults = false;
+    State.notify();
+  });
+  form.addEventListener("submit", (event) => {
+    event.preventDefault();
+    const text = query.value.trim();
+    if (!text || search.disabled) return;
+    query.blur();
+    search.disabled = true;
+    error.textContent = "";
+    showResults = true;
+    clear(matches);
+    matches.append(h("div", { class: "np-sub", text: tl("Searching…") }));
+    State.notify();
+    void Bridge.youtubeMusicSearch(text).then((found) => {
+      results = found;
+      selectedKind = found[0]?.kind ?? "song";
+      renderResults();
+    }).catch((err) => {
+      console.error("[coucou] YouTube Music search failed", err);
+      results = [];
+      clear(matches);
+      matches.append(h("div", { class: "np-sub", text: tl("Failed") }));
+    }).finally(() => { search.disabled = false; });
+  });
+  query.addEventListener("pointerdown", () => keyboard(true));
+  query.addEventListener("focus", () => keyboard(true));
+  query.addEventListener("blur", () => keyboard(false));
+  query.addEventListener("keydown", (event) => {
+    if (event.key === "Escape") query.blur();
+    event.stopPropagation();
+  });
+  open.addEventListener("click", () => {
+    error.textContent = "";
+    void Bridge.youtubeMusicOpen().catch(() => { error.textContent = t("Could not open YouTube Music"); });
+  });
+
+  const previous = h("button", { class: "np-icon", "aria-label": tl("Previous") }, svg(ICONS.backward, 14));
+  const play = h("button", { class: "np-play" });
+  const next = h("button", { class: "np-icon", "aria-label": tl("Next") }, svg(ICONS.forward, 14));
+  previous.addEventListener("click", () => void Bridge.youtubeMusicControl("previous"));
+  play.addEventListener("click", () => void Bridge.youtubeMusicControl("toggle"));
+  next.addEventListener("click", () => void Bridge.youtubeMusicControl("next"));
+  const volume = h("input", { type: "range", min: 0, max: 100, value: 50, "aria-label": tl("YouTube Music volume") });
+  let pendingVolume: number | null = null;
+  volume.addEventListener("input", () => {
+    const requested = volume.valueAsNumber;
+    pendingVolume = requested;
+    void Bridge.youtubeMusicControl("volume", requested).then((sent) => {
+      if (!sent && pendingVolume === requested) pendingVolume = null;
+    });
+  });
+  const controls = h("div", { class: "np-controls" },
+    h("div", { class: "np-buttons" }, previous, play, next),
+    h("div", { class: "np-volume" }, svg(ICONS.volume2, 14, { stroke: 1.5 }), volume),
+  );
+  const el = h("div", { class: "np-card np-youtube" }, head, form, controls, error);
+  let playing: boolean | undefined;
+  return {
+    el,
+    resultsEl,
+    get showResults() { return showResults; },
+    sync() {
+      const active = YouTubeMusic.playback;
+      title.textContent = active?.title || "YouTube Music";
+      artist.textContent = active?.artist || t("Not playing");
+      previous.disabled = play.disabled = next.disabled = !active?.title;
+      volume.disabled = !active;
+      if (active && active.volume === pendingVolume) pendingVolume = null;
+      if (active && pendingVolume == null && document.activeElement !== volume) volume.value = String(active.volume);
+      play.setAttribute("aria-label", active?.playing ? t("Pause") : t("Play"));
+      const isPlaying = active?.playing ?? false;
+      if (playing !== isPlaying) {
+        clear(play);
+        play.append(svg(isPlaying ? ICONS.pause : ICONS.play, 14));
+        playing = isPlaying;
+      }
+    },
+  };
+}
