diff --git a/windows/tests/youtube-music.test.mjs b/windows/tests/youtube-music.test.mjs
new file mode 100644
index 0000000..abf0be1
--- /dev/null
+++ b/windows/tests/youtube-music.test.mjs
@@ -0,0 +1,89 @@
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import test from "node:test";
+import { runInNewContext } from "node:vm";
+
+const script = readFileSync(new URL("../src-tauri/src/youtube_music.js", import.meta.url), "utf8");
+
+test("the injected controls exist only in the YouTube Music origin", () => {
+  const window = {};
+  runInNewContext(script, { window, location: new URL("https://www.youtube.com/watch?v=example") });
+  assert.equal(window.coucouMusic, undefined);
+});
+
+test("music search yields deduplicated songs and playlists from the active query", () => {
+  const window = {};
+  let played = "";
+  const makeRow = (title, href, playlist = false) => ({
+    querySelector: (selector) => selector === ".title" ? { textContent: title }
+      : playlist ? { click: () => { played = title; } } : null,
+    querySelectorAll: () => [{ href, click: () => { played = title; } }],
+  });
+  const song = makeRow("First song", "https://music.youtube.com/watch?v=valid-song");
+  const playlist = makeRow("Good playlist", "https://music.youtube.com/browse/VLplaylist_id", true);
+  const page = { data: {}, querySelector: () => ({}), querySelectorAll: () => [
+    song, song, playlist, makeRow("Browser video", "https://www.youtube.com/watch?v=outside"),
+  ] };
+  runInNewContext(script, {
+    window, URL, location: new URL("https://music.youtube.com/search?q=example"),
+    localStorage: { getItem: () => null },
+    document: { querySelector: () => page, addEventListener() {} },
+    MutationObserver: class { observe() {} },
+  });
+  const player = window.coucouMusic;
+  assert.equal(player.results("old"), null);
+  assert.deepEqual(JSON.parse(JSON.stringify(player.results("example"))), [
+    { id: "valid-song", kind: "song", title: "First song" },
+    { id: "playlist_id", kind: "playlist", title: "Good playlist" },
+  ]);
+  assert.equal(player.play("song", "valid-song"), true);
+  assert.equal(played, "First song");
+  assert.equal(player.play("playlist", "playlist_id"), true);
+  assert.equal(played, "Good playlist");
+  assert.equal(player.play("song", "outside"), false);
+});
+
+test("the player's volume survives an ad and carries over to a replacement audio element", () => {
+  let ad = false;
+  let element = { volume: 1, muted: false, currentSrc: "track", paused: false, ended: false };
+  let skipped = 0;
+  const storage = new Map();
+  const player = {
+    classList: { contains: () => ad },
+    querySelector: (selector) => selector === "video, audio" ? element : { click: () => { skipped++; } },
+  };
+  const window = {};
+  const handlers = new Map();
+  runInNewContext(script, {
+    window,
+    location: new URL("https://music.youtube.com/"),
+    localStorage: { getItem: (key) => storage.get(key) ?? null, setItem: (key, value) => storage.set(key, value) },
+    navigator: { mediaSession: { metadata: { title: "Song", artist: "Artist" } } },
+    document: { querySelector: (selector) => selector === "#movie_player" ? player : null,
+      addEventListener: (name, callback) => handlers.set(name, callback) },
+    MutationObserver: class { observe() {} },
+  });
+  const controls = window.coucouMusic;
+  assert.equal(controls.state().title, "Song");
+  assert.equal(element.volume, 0.5);
+  controls.volume(23);
+  assert.equal(element.volume, 0.23);
+  assert.equal(storage.get("coucou.music.volume"), "23");
+  element.volume = 0.8;
+  handlers.get("volumechange")({ target: element });
+  assert.equal(element.volume, 0.23);
+  element.volume = 1;
+  assert.equal(controls.state().volume, 23);
+  assert.equal(element.volume, 0.23);
+  ad = true;
+  assert.equal(controls.state().playing, false);
+  assert.equal(element.muted, true);
+  assert.equal(skipped, 1);
+  ad = false;
+  assert.equal(controls.state().playing, true);
+  assert.equal(element.muted, false);
+  assert.equal(element.volume, 0.23);
+  element = { ...element, volume: 1 };
+  assert.equal(controls.state().volume, 23);
+  assert.equal(element.volume, 0.23);
+});
