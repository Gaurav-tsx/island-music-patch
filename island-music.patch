diff --git a/windows/src-tauri/src/youtube_music.js b/windows/src-tauri/src/youtube_music.js
new file mode 100644
index 0000000..9588283
--- /dev/null
+++ b/windows/src-tauri/src/youtube_music.js
@@ -0,0 +1,168 @@
+(() => {
+  if (location.origin !== "https://music.youtube.com") return;
+
+  const volumeKey = "coucou.music.volume";
+  const savedVolume = localStorage.getItem(volumeKey);
+  let volume = savedVolume === null ? 50 : Math.max(0, Math.min(100, Number(savedVolume) || 0));
+  let previousMedia = null;
+  let mutedBeforeAd = null;
+  let searchRevision = 0;
+  let previousSearchData;
+  const searchPage = () => document.querySelector("ytmusic-search-page");
+  const player = () => document.querySelector("#movie_player");
+  const media = () => player()?.querySelector("video, audio");
+  const showingAd = () => player()?.classList.contains("ad-showing") ?? false;
+
+  function applyVolume(element) {
+    const level = volume / 100;
+    if (Math.abs(element.volume - level) > 0.0001) element.volume = level;
+  }
+
+  function updatePlayer() {
+    const element = media();
+    if (!element) return;
+    if (previousMedia !== element) {
+      previousMedia = element;
+      mutedBeforeAd = null;
+    }
+    applyVolume(element);
+    if (showingAd()) {
+      mutedBeforeAd ??= element.muted;
+      element.muted = true;
+      const skip = player().querySelector(
+        ".ytp-skip-ad-button, .ytp-ad-skip-button-modern, .ytp-ad-skip-button"
+      );
+      if (skip && !skip.disabled) skip.click();
+      else if (Number.isFinite(element.duration) && element.currentTime < element.duration - 0.1) {
+        element.currentTime = element.duration;
+      }
+    } else if (mutedBeforeAd !== null) {
+      element.muted = mutedBeforeAd;
+      mutedBeforeAd = null;
+    }
+  }
+
+  let pending = false;
+  new MutationObserver(() => {
+    if (pending) return;
+    pending = true;
+    queueMicrotask(() => {
+      pending = false;
+      updatePlayer();
+    });
+  }).observe(document, { subtree: true, childList: true, attributes: true, attributeFilter: ["class"] });
+  document.addEventListener("loadedmetadata", updatePlayer, true);
+  document.addEventListener("playing", updatePlayer, true);
+  document.addEventListener("volumechange", (event) => {
+    if (event.target === media()) applyVolume(event.target);
+  }, true);
+
+  function searchResults() {
+    const results = new Map();
+    const rows = searchPage()?.querySelectorAll(
+      "ytmusic-responsive-list-item-renderer, ytmusic-two-row-item-renderer, ytmusic-card-shelf-renderer"
+    ) ?? [];
+    for (const row of rows) {
+      const title = row.querySelector(".title")?.textContent?.trim();
+      if (!title) continue;
+      for (const link of row.querySelectorAll("a[href]")) {
+        const url = new URL(link.href, location.href);
+        if (url.origin !== location.origin) continue;
+        const kind = url.pathname === "/watch" ? "song" : "playlist";
+        const id = kind === "song" ? url.searchParams.get("v")
+          : url.pathname === "/playlist" ? url.searchParams.get("list")
+          : url.pathname.startsWith("/browse/VL") ? url.pathname.slice(10) : null;
+        if (!id || !/^[A-Za-z0-9_-]{1,128}$/.test(id)) continue;
+        const key = `${kind}:${id}`;
+        if (!results.has(key)) results.set(key, { id, kind, title: title.slice(0, 256), row, link });
+        break;
+      }
+    }
+    return results;
+  }
+
+  window.coucouMusic = {
+    search(url) {
+      const revision = ++searchRevision;
+      const app = document.querySelector("ytmusic-app");
+      if (!app?.querySelector("ytmusic-search-box")) {
+        location.assign(url);
+        return;
+      }
+      const destination = new URL(url);
+      const original = location.href;
+      previousSearchData = new URL(original).searchParams.get("q") === destination.searchParams.get("q")
+        ? undefined : searchPage()?.data;
+      app.dispatchEvent(new CustomEvent("yt-navigate", {
+        bubbles: true, composed: true,
+        detail: { endpoint: {
+          commandMetadata: { webCommandMetadata: { url: destination.pathname + destination.search } },
+          searchEndpoint: { query: destination.searchParams.get("q") },
+        } },
+      }));
+      setTimeout(() => {
+        if (revision === searchRevision && location.href === original && original !== url) location.assign(url);
+      }, 800);
+    },
+    results(query) {
+      const active = new URL(location.href);
+      const page = searchPage();
+      if (active.pathname !== "/search" || active.searchParams.get("q") !== query
+        || !page?.data || page.data === previousSearchData
+        || !page.querySelector("ytmusic-section-list-renderer")) return null;
+      return [...searchResults().values()].slice(0, 40).map(({ id, kind, title }) => ({ id, kind, title }));
+    },
+    play(kind, id) {
+      const result = searchResults().get(`${kind}:${id}`);
+      if (!result) return false;
+      if (kind === "song") {
+        result.link.click();
+        return true;
+      }
+      const button = result.row.querySelector("ytmusic-play-button-renderer");
+      if (button) {
+        button.click();
+        return true;
+      }
+      const overlay = result.row.data?.overlay?.musicItemThumbnailOverlayRenderer;
+      const endpoint = overlay?.content?.musicPlayButtonRenderer?.playNavigationEndpoint;
+      if (endpoint) {
+        result.row.dispatchEvent(new CustomEvent("yt-navigate", {
+          bubbles: true, composed: true, detail: { endpoint },
+        }));
+      } else {
+        const destination = new URL("/watch", location.origin);
+        destination.searchParams.set("list", id);
+        location.assign(destination.href);
+      }
+      return true;
+    },
+    state() {
+      updatePlayer();
+      const element = media();
+      const metadata = navigator.mediaSession?.metadata;
+      const bar = document.querySelector("ytmusic-player-bar");
+      const hasTrack = element?.currentSrc && !showingAd();
+      return {
+        title: hasTrack ? (metadata?.title || bar?.querySelector(".title")?.textContent || "").trim().slice(0, 256) : "",
+        artist: hasTrack ? (metadata?.artist || bar?.querySelector(".byline")?.textContent || "").trim().slice(0, 256) : "",
+        playing: !!hasTrack && !element.paused && !element.ended,
+        volume,
+      };
+    },
+    toggle() {
+      const element = media();
+      if (!element) return;
+      if (element.paused) void element.play().catch(() => {});
+      else element.pause();
+    },
+    next() { document.querySelector("ytmusic-player-bar .next-button")?.click(); },
+    previous() { document.querySelector("ytmusic-player-bar .previous-button")?.click(); },
+    volume(value) {
+      volume = value;
+      localStorage.setItem(volumeKey, String(volume));
+      const element = media();
+      if (element) applyVolume(element);
+    },
+  };
+})();
diff --git a/windows/src-tauri/src/youtube_music.rs b/windows/src-tauri/src/youtube_music.rs
new file mode 100644
index 0000000..2a370b0
--- /dev/null
+++ b/windows/src-tauri/src/youtube_music.rs
@@ -0,0 +1,217 @@
+use serde::{de::DeserializeOwned, Deserialize, Serialize};
+use std::time::Duration;
+use tauri::webview::NewWindowResponse;
+use tauri::{AppHandle, Manager, Url, WebviewUrl, WebviewWindow, WebviewWindowBuilder};
+
+const LABEL: &str = "youtube-music";
+const PILL_ID: &str = "integration_youtube_music";
+const HOME: &str = "https://music.youtube.com/";
+const SCRIPT: &str = include_str!("youtube_music.js");
+static WINDOW: tokio::sync::Mutex<()> = tokio::sync::Mutex::const_new(());
+
+#[cfg(windows)]
+fn install_ad_filter(window: &WebviewWindow) -> tauri::Result<()> {
+    use webview2_com::Microsoft::Web::WebView2::Win32::{
+        COREWEBVIEW2_WEB_RESOURCE_CONTEXT_ALL, COREWEBVIEW2_WEB_RESOURCE_REQUEST_SOURCE_KINDS_ALL,
+        ICoreWebView2_22,
+    };
+    use webview2_com::{WebResourceRequestedEventHandler, take_pwstr};
+    use wv2_core::{Interface, PWSTR, w};
+
+    window.with_webview(|webview| {
+        let install = || -> wv2_core::Result<()> {
+            // The repository's other webviews and external browsers keep their own request handling.
+            let core = unsafe { webview.controller().CoreWebView2()? };
+            let environment = webview.environment();
+            let newest = core.cast::<ICoreWebView2_22>();
+            for pattern in [
+                w!("https://*.doubleclick.net/*"),
+                w!("https://*.googleadservices.com/*"),
+                w!("https://music.youtube.com/pagead/*"),
+                w!("https://www.youtube.com/pagead/*"),
+            ] {
+                unsafe {
+                    if let Ok(core) = &newest {
+                        core.AddWebResourceRequestedFilterWithRequestSourceKinds(
+                            pattern, COREWEBVIEW2_WEB_RESOURCE_CONTEXT_ALL,
+                            COREWEBVIEW2_WEB_RESOURCE_REQUEST_SOURCE_KINDS_ALL,
+                        )?;
+                    } else {
+                        core.AddWebResourceRequestedFilter(pattern, COREWEBVIEW2_WEB_RESOURCE_CONTEXT_ALL)?;
+                    }
+                }
+            }
+            let handler = WebResourceRequestedEventHandler::create(Box::new(move |_, args| {
+                let Some(args) = args else { return Ok(()) };
+                unsafe {
+                    let mut uri = PWSTR::null();
+                    args.Request()?.Uri(&mut uri)?;
+                    let Ok(url) = Url::parse(&take_pwstr(uri)) else { return Ok(()) };
+                    let host = url.host_str().unwrap_or("");
+                    let is_ad = host.ends_with(".doubleclick.net") || host.ends_with(".googleadservices.com")
+                        || (matches!(host, "www.youtube.com" | "music.youtube.com") && url.path().starts_with("/pagead/"));
+                    if is_ad {
+                        let response = environment.CreateWebResourceResponse(None, 204, w!("No Content"), w!(""))?;
+                        args.SetResponse(&response)?;
+                    }
+                }
+                Ok(())
+            }));
+            unsafe { core.add_WebResourceRequested(&handler, &mut 0) }
+        };
+        if let Err(err) = install() {
+            crate::log::line(format!("YouTube Music ad filter: {err}"));
+        }
+    })
+}
+
+#[derive(Deserialize, Serialize)]
+pub struct Playback {
+    title: String,
+    artist: String,
+    playing: bool,
+    volume: u8,
+}
+
+#[derive(Deserialize, Serialize)]
+pub struct SearchResult {
+    id: String,
+    kind: String,
+    title: String,
+}
+
+fn enabled(app: &AppHandle) -> bool {
+    cfg!(windows)
+        && app.state::<crate::Shared>().settings.lock().unwrap()
+            .active_integrations.iter().any(|id| id == PILL_ID)
+}
+
+fn navigate_to_search(window: &WebviewWindow, destination: &Url) -> tauri::Result<()> {
+    // Let the site handle its own navigation when it has finished loading so
+    // searching doesn't replace the page that owns the active player.
+    let endpoint = serde_json::to_string(destination.as_str()).unwrap();
+    window.eval(format!("if (window.coucouMusic && location.origin === 'https://music.youtube.com') {{
+        window.coucouMusic.search({endpoint});
+    }} else {{ location.href = {endpoint}; }}"))
+}
+
+fn player_window(app: &AppHandle, destination: Url, show: bool) -> tauri::Result<WebviewWindow> {
+    if let Some(window) = app.get_webview_window(LABEL) {
+        if show {
+            window.set_skip_taskbar(false)?;
+            window.show()?;
+            window.unminimize()?;
+            window.set_focus()?;
+        } else {
+            window.hide()?;
+            window.set_skip_taskbar(true)?;
+        }
+        if destination.path() == "/search" {
+            navigate_to_search(&window, &destination)?;
+        }
+        return Ok(window);
+    }
+    let profile = app.path().app_local_data_dir()?.join(LABEL);
+    // This remote window has no entry in the app's Tauri capabilities.
+    let window = WebviewWindowBuilder::new(app, LABEL, WebviewUrl::External(destination))
+        .title("YouTube Music · Coucou")
+        .inner_size(960.0, 640.0)
+        .visible(show)
+        .focused(show)
+        .skip_taskbar(!show)
+        .additional_browser_args(crate::BROWSER_ARGS)
+        .data_directory(profile)
+        .initialization_script(SCRIPT)
+        .on_navigation(|url| {
+            url.scheme() == "https" && url.port().is_none()
+                && matches!(url.host_str(), Some("music.youtube.com" | "accounts.google.com"))
+        })
+        .on_new_window(|_, _| NewWindowResponse::Deny)
+        .build()?;
+    #[cfg(windows)]
+    install_ad_filter(&window)?;
+    let handle = app.clone();
+    window.on_window_event(move |event| {
+        if let tauri::WindowEvent::CloseRequested { api, .. } = event {
+            api.prevent_close();
+            if let Some(window) = handle.get_webview_window(LABEL) {
+                let _ = window.hide();
+                let _ = window.set_skip_taskbar(true);
+            }
+        }
+    });
+    Ok(window)
+}
+
+#[tauri::command]
+pub async fn youtube_music_open(app: AppHandle) -> Result<(), String> {
+    let _guard = WINDOW.lock().await;
+    if !enabled(&app) { return Err("Enable the YouTube Music pill first.".into()); }
+    player_window(&app, Url::parse(HOME).unwrap(), true).map(|_| ()).map_err(|err| err.to_string())
+}
+
+async fn evaluate<T: DeserializeOwned + Send + 'static>(window: &WebviewWindow, script: impl Into<String>) -> Option<T> {
+    let (send, mut receive) = tokio::sync::mpsc::channel(1);
+    window.eval_with_callback(script, move |json| {
+        let _ = send.try_send(serde_json::from_str::<T>(&json).ok());
+    }).ok()?;
+    tokio::time::timeout(Duration::from_secs(2), receive.recv()).await.ok()??
+}
+
+#[tauri::command]
+pub async fn youtube_music_search(app: AppHandle, query: String) -> Result<Vec<SearchResult>, String> {
+    let query = query.trim();
+    if query.is_empty() || query.chars().count() > 200 { return Err("Invalid search query.".into()); }
+    let window = {
+        let _guard = WINDOW.lock().await;
+        if !enabled(&app) { return Err("Enable the YouTube Music pill first.".into()); }
+        let mut destination = Url::parse(HOME).unwrap();
+        destination.set_path("search");
+        destination.query_pairs_mut().append_pair("q", query);
+        player_window(&app, destination, false).map_err(|err| err.to_string())?
+    };
+    let query = serde_json::to_string(query).unwrap();
+    let script = format!("window.coucouMusic?.results({query}) ?? null");
+    tokio::time::timeout(Duration::from_secs(15), async {
+        loop {
+            if let Some(results) = evaluate(&window, script.clone()).await { return results; }
+            tokio::time::sleep(Duration::from_millis(250)).await;
+        }
+    }).await.map_err(|_| "YouTube Music search timed out.".into())
+}
+
+#[tauri::command]
+pub async fn youtube_music_play(app: AppHandle, kind: String, id: String) -> bool {
+    if !matches!(kind.as_str(), "song" | "playlist") || id.is_empty() || id.len() > 128
+        || !id.bytes().all(|byte| byte.is_ascii_alphanumeric() || byte == b'-' || byte == b'_') {
+        return false;
+    }
+    let Some(window) = app.get_webview_window(LABEL) else { return false };
+    evaluate(&window, format!("window.coucouMusic?.play('{kind}', '{id}') ?? false")).await.unwrap_or(false)
+}
+
+#[tauri::command]
+pub async fn youtube_music_state(app: AppHandle) -> Option<Playback> {
+    let window = app.get_webview_window(LABEL)?;
+    evaluate(&window, "window.coucouMusic?.state() ?? null").await
+}
+
+#[tauri::command]
+pub fn youtube_music_control(app: AppHandle, action: String, volume: Option<u8>) -> bool {
+    let script = match action.as_str() {
+        "toggle" => "window.coucouMusic?.toggle()".to_string(),
+        "next" => "window.coucouMusic?.next()".to_string(),
+        "previous" => "window.coucouMusic?.previous()".to_string(),
+        "volume" => format!("window.coucouMusic?.volume({})", volume.unwrap_or(50).min(100)),
+        _ => return false,
+    };
+    app.get_webview_window(LABEL).is_some_and(|window| window.eval(script).is_ok())
+}
+
+pub fn sync(app: &AppHandle, integrations: &[String]) {
+    if !integrations.iter().any(|id| id == PILL_ID) {
+        if let Some(window) = app.get_webview_window(LABEL) {
+            let _ = window.destroy();
+        }
+    }
+}
